// Cloudflare Workers: o site (arquivos estáticos desta pasta) + o carteiro dos envios em /api/...
{
  "name": "gerador",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/index"]
  },
  "observability": { "enabled": true }
}
